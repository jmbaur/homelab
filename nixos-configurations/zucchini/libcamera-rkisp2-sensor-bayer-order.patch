rkisp2: Use the sensor's own Bayer order

The default configuration and the raw format fallback assumed SRGGB10. For a
sensor with another Bayer order, such as the OV13855 (SBGGR10) or the IMX415
(SGBRG10), no sensor format is found and clampSensorSize() dereferences an
empty size list. Pick the raw format the same way the rkisp1 pipeline
handler does instead: the one with the most bits per pixel that both the
sensor and VICAP support.

Link: https://patchwork.libcamera.org/comment/40791/

--- a/src/libcamera/pipeline/rkisp2/rkisp2.cpp
+++ b/src/libcamera/pipeline/rkisp2/rkisp2.cpp
@@ -117,6 +117,7 @@
 		 V4L2VideoDevice *stat);
 	PixelFormat getSensorFormat(unsigned int mbusCode, const Size &size,
 				    const Size &maxSize);
+	unsigned int sensorRawMbusCode() const;
 
 	PipelineHandlerRkISP2 *pipe();
 	const PipelineHandlerRkISP2 *pipe() const;
@@ -315,6 +316,32 @@
 	return formats::SRGGB10;
 }
 
+/*
+ * The raw media bus code with the highest bits per pixel that both the sensor
+ * and VICAP support, as the rkisp1 pipeline handler picks its raw format, or
+ * 0 if there is none.
+ */
+unsigned int RkISP2CameraData::sensorRawMbusCode() const
+{
+	const std::vector<unsigned int> mbusCodes = sensor_->mbusCodes();
+	unsigned int rawBitsPerPixel = 0;
+	unsigned int rawMbusCode = 0;
+
+	for (const auto &[format, mbusCode] : rawFormats) {
+		if (std::find(mbusCodes.begin(), mbusCodes.end(), mbusCode) ==
+		    mbusCodes.end())
+			continue;
+
+		const PixelFormatInfo &info = PixelFormatInfo::info(format);
+		if (info.bitsPerPixel > rawBitsPerPixel) {
+			rawBitsPerPixel = info.bitsPerPixel;
+			rawMbusCode = mbusCode;
+		}
+	}
+
+	return rawMbusCode;
+}
+
 PipelineHandlerRkISP2 *RkISP2CameraData::pipe()
 {
 	return static_cast<PipelineHandlerRkISP2 *>(Camera::Private::pipe());
