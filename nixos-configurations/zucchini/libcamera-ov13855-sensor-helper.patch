libipa: camera_sensor_helper: Add OV13855 helper

The OV13855 uses the same linear gain code as the OV13858, with 0x80 as 1x,
and a black level of 64 at 10 bits.

--- a/src/ipa/libipa/camera_sensor_helper.cpp
+++ b/src/ipa/libipa/camera_sensor_helper.cpp
@@ -866,6 +866,19 @@
 };
 REGISTER_CAMERA_SENSOR_HELPER("ov8865", CameraSensorHelperOv8865)
 
+class CameraSensorHelperOv13855 : public CameraSensorHelper
+{
+public:
+	CameraSensorHelperOv13855()
+	{
+		/* From the Rockchip driver: 64 at 10bits. */
+		blackLevel_ = 4096;
+		/* Gain code 0x80 is 1x, like the OV13858. */
+		gain_ = AnalogueGainLinear{ 1, 0, 0, 128 };
+	}
+};
+REGISTER_CAMERA_SENSOR_HELPER("ov13855", CameraSensorHelperOv13855)
+
 class CameraSensorHelperOv13858 : public CameraSensorHelper
 {
 public:
