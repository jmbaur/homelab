+	struct v4l2_ctrl *pixel_rate;
+	struct v4l2_ctrl *link_freq;
+	struct v4l2_ctrl *test_pattern;
+	struct mutex mutex;
+	bool streaming;
+	bool power_on;
+	const struct ov13855_mode *cur_mode;
+	u32 module_index;
+	const char *module_facing;
+	const char *module_name;
+	const char *len_name;
+
+	struct otp_info *otp;
+};
