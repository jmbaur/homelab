 static constexpr unsigned int kRkISP2MinBufferCount = 4;
 
+/*
+ * Find the video capture device closest to the sensor with a breadth-first
+ * search, as the simple pipeline handler does.
+ */
+MediaEntity *findCaptureDevice(MediaEntity *sensor)
+{
+	std::unordered_set<MediaEntity *> visited{ sensor };
+	std::queue<MediaEntity *> queue;
+
+	queue.push(sensor);
+
+	while (!queue.empty()) {
+		MediaEntity *entity = queue.front();
+		queue.pop();
+
+		if (entity->function() == MEDIA_ENT_F_IO_V4L)
+			return entity;
+
+		for (const MediaPad *pad : entity->pads()) {
+			if (!(pad->flags() & MEDIA_PAD_FL_SOURCE))
+				continue;
+
+			for (const MediaLink *link : pad->links()) {
+				MediaEntity *next = link->sink()->entity();
+				if (visited.insert(next).second)
+					queue.push(next);
+			}
+		}
+	}
+
+	return nullptr;
+}
+
 } /* namespace */
 
