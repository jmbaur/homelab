 drivers/char/hw_random/Kconfig  |  12 ++
 drivers/char/hw_random/Makefile |   1 +
 drivers/char/hw_random/rng90.c  | 353 ++++++++++++++++++++++++++++++++
 4 files changed, 372 insertions(+)
 create mode 100644 drivers/char/hw_random/rng90.c

